# Large Uploads (Keep these on local disk, not in Git)
/uploads/reports/
/uploads/users/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Mobile Dependencies & Env
/mobile/node_modules/
/mobile/.expo/
/mobile/dist/
.env
*.log

# Web/Admin Temp
.DS_Store
Thumbs.db

# AI Models — exclude large originals, allow quantized versions
*.keras
*.h5
# Allow quantized TFLite models and YOLO weights (all under 100 MB)
!*.tflite
!*.pt

uploads/
node_modules/
flask_api/venv/
